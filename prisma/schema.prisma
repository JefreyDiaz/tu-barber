// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  customDomain String?  @unique
  status             String    @default("pending") // pending | active | suspended | rejected
  plan               String    @default("emprendedor") // emprendedor | negocio | cadena
  subscriptionStatus String    @default("none")    // none | trialing | active | past_due | canceled
  trialEndsAt        DateTime?
  timezone           String    @default("America/Bogota")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings     TenantSettings?
  onboarding   TenantOnboarding?
  users        User[]
  bookings     Booking[]
  blockedSlots BlockedSlot[]
  services     Service[]
}

model TenantSettings {
  tenantId            String  @id
  tenant              Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logoUrl             String?
  primaryColor        String?
  slotDurationMinutes Int     @default(40)
  minAdvanceHours     Int     @default(1)
  maxAdvanceDays      Int     @default(30)
  cancelNoticeHours   Int     @default(2)
  scheduleJson            Json?
  twilioAccountSid        String?
  twilioAuthToken         String?
  twilioWhatsappFrom      String?
  twilioContentSidBooking  String?
  twilioContentSidBarber   String?
  twilioContentSidReminder String?
}

model TenantOnboarding {
  tenantId      String    @id
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerName     String
  ownerEmail    String
  ownerPhone    String
  submittedAt   DateTime  @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  rejectionNote String?
}

model User {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  username  String
  password  String
  photo     String?
  email     String?
  phone     String?
  role      String   @default("barbero") // super_admin, admin, dueno, barbero
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings     Booking[]
  blockedSlots BlockedSlot[] @relation("blockedSlots")

  @@unique([tenantId, username])
  @@index([tenantId])
}

model Booking {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barberId        String
  barber          User      @relation(fields: [barberId], references: [id], onDelete: Cascade)
  serviceId       String?
  service         Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  durationMinutes Int       @default(40)
  customerName    String
  customerPhone   String
  dateTime        DateTime
  status          String    @default("pending")
  reminderSentAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId, barberId, dateTime])
  @@index([barberId, dateTime])
  @@index([dateTime])
  @@index([reminderSentAt, dateTime])
  @@index([tenantId])
}

model Service {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bookings Booking[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model BlockedSlot {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barberId  String
  barber    User     @relation("blockedSlots", fields: [barberId], references: [id], onDelete: Cascade)
  date      DateTime
  isFullDay Boolean  @default(false)
  time      String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([tenantId, barberId, date])
  @@index([barberId, date])
  @@unique([barberId, date, time])
}
